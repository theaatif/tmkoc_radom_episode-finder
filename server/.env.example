# ══════════════════════════════════════════════
# TMKOC API — Environment Variables
# ══════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ── Server ──
PORT=5000
NODE_ENV=development

# ── Logging ──
# One of: debug, info, warn, error
# LOG_LEVEL=info

# ── MongoDB ──
MONGODB_URI=mongodb://localhost:27017/tmkoc

# ── Redis ──
# In production, set REDIS_PASSWORD and ensure Redis binds to 127.0.0.1
# or use a firewall. Never expose Redis to the public internet without auth.
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# ── JWT ──
# MUST be at least 32 characters (256 bits) in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth 2.0 ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console exactly.
# For the auth code flow, the client sends the user to Google's consent screen,
# Google redirects back to this URI, and the client sends the resulting code
# to POST /auth/google/code.
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
# Restrict sign-in to a specific Google Workspace domain (optional).
# GOOGLE_HOSTED_DOMAIN=example.com

# ── CORS ──
CLIENT_URL=http://localhost:3000

# ── Cookie ──
# Set to "true" in production (requires HTTPS)
COOKIE_SECURE=false
# Restrict cookies to your domain in production (e.g. .example.com)
# COOKIE_DOMAIN=

# ── Request limits ──
REQUEST_TIMEOUT_MS=30000
